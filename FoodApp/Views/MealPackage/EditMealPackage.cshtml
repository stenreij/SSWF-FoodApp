@using Core.Domain
@model FoodApp.Models.MealPackageViewModel

@{
    ViewData["Title"] = "Edit MealPackage";
}

    <div class="page-heading"><div><h1>Pakket bewerken</h1><p class="page-intro">Pas de gegevens, ophaaltijd of inhoud van het maaltijdpakket aan.</p></div></div>
    <form method="post" action="/MealPackage/EditMealPackage" class="panel">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="Name" class="form-label">Naam van het pakket</label>
            <input type="text" class="form-control" asp-for="Name">
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="PickUpDateTime" class="form-label">Ophaaltijd</label>
            <input type="datetime-local" class="form-control" asp-for="PickUpDateTime">
            <span asp-validation-for="PickUpDateTime" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ExpireDateTime" class="form-label">Beschikbaar tot</label>
            <input type="datetime-local" class="form-control" asp-for="ExpireDateTime">
            <span asp-validation-for="ExpireDateTime" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Price" class="form-label">Prijs</label>
            <input type="number" step="0.01" class="form-control" asp-for="Price">
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="MealType" class="form-label">Type maaltijd</label>
            <select asp-for="MealType" class="form-control" asp-items="Html.GetEnumSelectList<MealType>()"></select>
            <span asp-validation-for="MealType" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="CanteenId" class="form-label">Kantine</label>
            <select asp-for="CanteenId" class="form-control" id="canteenDropdown">
                @foreach (var canteen in ViewBag.Canteens)
                {
                    <option value="@canteen.Id">@canteen.CanteenName</option>
                }
            </select>
        </div>
        @if (Model != null && Model.Products != null)
        {
            <label class="form-label">Producten in dit pakket</label>
            <div class="product-grid">
            @foreach (var product in Model.Products)
            {
                <label class="product-option" for="product-@product.Id"><input id="product-@product.Id" class="form-check-input" type="checkbox" name="SelectedProducts" value="@product.Id" @(Model.SelectedProducts?.Contains(product.Id) ?? false ? "checked" : "")><span class="form-check-label">@product.Name</span></label>
            }
            </div>
        }

        <div class="d-flex flex-wrap gap-2 mt-4"><button type="submit" class="btn btn-primary px-4">Wijzigingen opslaan</button><a asp-controller="MealPackage" asp-action="MealOverview" class="btn btn-outline-primary">Annuleren</a></div>
    </form>
