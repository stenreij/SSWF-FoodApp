@using Core.Domain
@model FoodApp.Models.MealPackageViewModel

@{
    ViewData["Title"] = "Pakket toevoegen";
}

<div class="page-heading"><div><h1>Nieuw maaltijdpakket</h1><p class="page-intro">Stel een aantrekkelijk pakket samen met producten uit jouw kantine.</p></div></div>
<form method="post" action="AddMealPackage" class="panel">
    <div class="form-row">
        <div class="mb-3"><label asp-for="Name" class="form-label">Naam van het pakket</label><input class="form-control" asp-for="Name" placeholder="Bijv. Lunchpakket met kip en fruit"><span asp-validation-for="Name" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Price" class="form-label">Prijs</label><div class="input-group"><span class="input-group-text">€</span><input type="number" step="0.01" min="0" class="form-control" asp-for="Price" placeholder="0,00"></div><span asp-validation-for="Price" class="text-danger"></span></div>
    </div>
    <div class="form-row">
        <div class="mb-3"><label asp-for="PickUpDateTime" class="form-label">Ophaaltijd</label><input type="datetime-local" class="form-control" asp-for="PickUpDateTime"><span asp-validation-for="PickUpDateTime" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="ExpireDateTime" class="form-label">Beschikbaar tot</label><input type="datetime-local" class="form-control" asp-for="ExpireDateTime"><span class="form-hint">Na dit tijdstip is reserveren niet meer mogelijk.</span><span asp-validation-for="ExpireDateTime" class="text-danger"></span></div>
    </div>
    <div class="mb-4"><label asp-for="MealType" class="form-label">Type maaltijd</label><select asp-for="MealType" class="form-select">@foreach (var mealType in ViewBag.MealTypes) { <option value="@mealType">@mealType</option> }</select><span asp-validation-for="MealType" class="text-danger"></span></div>
    <div class="mb-4">
        <label class="form-label">Producten in dit pakket</label><p class="form-hint mb-2">Selecteer de producten die de student ontvangt.</p>
        @if (Model.Products?.Any() == true)
        {
            <div class="product-grid">
            @foreach (var product in Model.Products!)
            {
                <label class="product-option" for="product-@product.Id"><input id="product-@product.Id" class="form-check-input" type="checkbox" name="SelectedProducts" value="@product.Id" @(Model.SelectedProducts?.Contains(product.Id) ?? false ? "checked" : "")><span class="form-check-label">@product.Name</span></label>
            }
            </div>
        }
        else { <p class="text-secondary">Er zijn nog geen producten beschikbaar voor deze kantine.</p> }
        <span asp-validation-for="SelectedProducts" class="text-danger"></span>
    </div>
    <div class="d-flex flex-wrap gap-2"><button type="submit" class="btn btn-primary px-4">Pakket publiceren</button><a asp-controller="MealPackage" asp-action="MealOverview" class="btn btn-outline-primary">Annuleren</a></div>
</form>
