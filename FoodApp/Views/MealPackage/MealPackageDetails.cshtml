@using Core.Domain
@model MealPackage

@{
    ViewData["Title"] = "MealPackage Details";
}

    <div class="page-heading"><div><h1>@Model.Name</h1><p class="page-intro">Bekijk wat er in het pakket zit en waar je het kunt ophalen.</p></div><span class="meal-price">@Model.Price.ToString("C")</span></div>
        <div class="panel">

            <dl class="details-list">
                <dt>Ophaaltijd</dt>
                <dd>@Model.PickUpDateTime.ToString("dd-MM-yyyy HH:mm")</dd>

                <dt>Beschikbaar tot</dt>
                <dd>@Model.ExpireDateTime.ToString("dd-MM-yyyy HH:mm")</dd>

                <dt>Type maaltijd</dt>
                <dd>@Model.MealType</dd>

                <dt>Geschikt voor 18+</dt>
                <dd>@(Model.AdultsOnly ? "Ja" : "Nee")</dd>

                <dt>Locatie</dt>
                <dd>@Model.Canteen.Location</dd>

                <dt>Kantine</dt>
                <dd>@Model.Canteen.CanteenName</dd>

                @if (User.IsInRole("employee"))
                {
                    <dt>Gereserveerd door</dt>
                    if (Model.ReservedByStudent != null)
                    {
                        <dd>@Model.ReservedByStudent.FirstName @Model.ReservedByStudent.LastName</dd>
                    }
                    else
                    {
                        <dd>Nog niet gereserveerd</dd>
                    }
                }               

                <dt>Producten</dt>
                <dd>
                    @foreach (var product in Model.Products)
                    {
                        <div>@product.Name</div>
                    }
                </dd>
            </dl>

            @if (User.IsInRole("student"))
            {
                @if (Model.ReservedByStudent == null)
                {
                    <form method="post" asp-controller="MealPackage" asp-action="ReserveMealPackage" asp-route-mealPackageId="@Model.Id" asp-route-studentId="@ViewBag.StudentId">
                        <button type="submit" class="btn btn-primary">Reserveer dit pakket</button>
                    </form>
                }
                else
                {
                    <form method="post" asp-controller="MealPackage" asp-action="CancelReservation" asp-route-mealPackageId="@Model.Id" asp-route-studentId="@ViewBag.studentId">
                        <button type="submit" class="btn btn-outline-danger">Reservering annuleren</button>
                    </form>
                }
            }
        </div>
